{
  "name": "dsh-qq-bridge",
  "version": "1.6.1",
  "description": "DSH 插件：通过 OneBot v11 接入 QQ 聊天，把 QQ 私聊/群聊消息交给 DSH Agent 处理并把回复发回 QQ（兼容 NapCatQQ / LLOneBot / Lagrange.OneBot）。设置页「设置 → QQ 桥接」可看状态、改配置、暂停/恢复；上下文到阈值会自动换新会话；回复可带表情包，还能定时醒来主动发消息。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "onebot",
    "napcat",
    "bridge"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
